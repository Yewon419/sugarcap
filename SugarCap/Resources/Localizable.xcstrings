        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過了%1$@ %2$@。\n%3$@還在等你。\n點一下杯子。"
          }
        }
      }
    },
    "%@ %@. 가장 가까운 사이예요" : {
