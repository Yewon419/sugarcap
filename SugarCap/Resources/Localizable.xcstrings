  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    "\"%@\" 메뉴가 없어요. 직접 입력으로 남길 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No menu item matches \"%@\". You can add it manually."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到「%@」。可以手動新增。"
          }
        }
      }
    },
    "%@ %@" : {
      "shouldTranslate" : false
    },
    "%@ %@ %@를 %@에게 주기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give %1$@ %2$@ %3$@ to %4$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把%2$@ %3$@的%1$@給%4$@"
