      }
    },
    "%@ %@ 넘겼어요.\n그래도 %@ 기다려요.\n컵을 눌러 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ over.\n%3$@ is still waiting.\nTap the cup."
